// ============================================================================
// TOKEN
// ============================================================================
class Token {
    public final TokenRepository.TokenType type;
    public final String value;
    public final int line, column, startOffset, endOffset;

    public Token(TokenRepository.TokenType type, String value, int line, int column, int startOffset, int endOffset) {
        this.type=type; 
        this.value=value; 
        this.line=line; 
        this.column=column;
        this.startOffset=startOffset; 
        this.endOffset=endOffset;
    }
    
    public boolean isType()     { return type.isType(); }
    public boolean isModifier() { return type.isModifier(); }
    public boolean isLiteral()  { return type.isLiteral(); }
    public boolean isOperator() { return type.isOperator(); }
    public boolean isComment()  { return type.isComment(); }
    
    @Override 
    public String toString() { 
        return String.format("[%s] '%s' @%d:%d", type.name(), value, line, column); 
    }
}

// ============================================================================
// AST NODE
// ============================================================================
class ASTNode {
    public enum NodeType {
        COMPILATION_UNIT, PACKAGE_DECLARATION, IMPORT_DECLARATION,
        CLASS_DECLARATION, INTERFACE_DECLARATION, ENUM_DECLARATION,
        METHOD_DECLARATION, CONSTRUCTOR_DECLARATION, FIELD_DECLARATION, VARIABLE_DECLARATION,
        BLOCK, IF_STATEMENT, FOR_STATEMENT, WHILE_STATEMENT, DO_WHILE_STATEMENT,
        SWITCH_STATEMENT, TRY_STATEMENT, RETURN_STATEMENT, EXPRESSION_STATEMENT
    }
    
    public final NodeType nodeType;
    public final String name;
    public final int line, startOffset, endOffset;
    public final List<ASTNode> children = new ArrayList<>();
    public final Map<String, Object> properties = new HashMap<>();

    public ASTNode(NodeType nodeType, String name, int line, int start, int end) {
        this.nodeType=nodeType; 
        this.name=name; 
        this.line=line; 
        this.startOffset=start; 
        this.endOffset=end;
    }
    
    public void addChild(ASTNode child) { 
        if (child!=null) children.add(child); 
    }
    
    public void setProperty(String k, Object v) { 
        properties.put(k, v); 
    }
    
    public Object getProperty(String k) { 
        return properties.get(k); 
    }
}

// ============================================================================
// CODE ERROR
// ============================================================================
class CodeError implements Comparable<CodeError> {
    public enum Severity {
        ERROR("Error", Theme.DANGER_COLOR), 
        WARNING("Warn", Theme.WARNING_COLOR),
        INFO("Info", Theme.TEXT_MUTED), 
        HINT("Hint", Theme.CYAN_COLOR);
        
        public final String label;
        public final Color  color;
        
        Severity(String label, Color color) { 
            this.label=label; 
            this.color=color; 
        }
    }
    
    public final String message, hint;
    public final int line, column, startOffset, endOffset;
    public final Severity severity;

    public CodeError(String message, String hint, int line, int column, int startOffset, int endOffset, Severity severity) {
        this.message=message; 
        this.hint=hint; 
        this.line=line; 
        this.column=column;
        this.startOffset=startOffset; 
        this.endOffset=endOffset; 
        this.severity=severity;
    }
    
    @Override 
    public int compareTo(CodeError o) {
        int c = Integer.compare(this.line, o.line);
        return c!=0 ? c : Integer.compare(this.column, o.column);
    }
}

// ============================================================================
// ERROR MANAGER
// ============================================================================
class ErrorManager {
    private final List<CodeError> errors = new ArrayList<>();
    private final Set<String> dedup = new HashSet<>();

    private void add(String msg, String hint, int line, int col, int start, int end, CodeError.Severity sev) {
        String key = line+":"+col+":"+msg;
        if (!dedup.contains(key)) { 
            dedup.add(key); 
            errors.add(new CodeError(msg,hint,line,col,start,end,sev)); 
        }
    }
    
    public void addSyntaxError  (String m,String h,int ln,int col,int s,int e){ add(m,h,ln,col,s,e,CodeError.Severity.ERROR); }
    public void addSemanticError(String m,String h,int ln,int col,int s,int e){ add(m,h,ln,col,s,e,CodeError.Severity.ERROR); }
    public void addError        (String m,String h,int ln,int col,int s,int e,CodeError.Severity sv){ add(m,h,ln,col,s,e,sv); }
    public void addWarning      (String m,String h,int ln,int col,int s,int e){ add(m,h,ln,col,s,e,CodeError.Severity.WARNING); }
    public void addInfo         (String m,String h,int ln,int col,int s,int e){ add(m,h,ln,col,s,e,CodeError.Severity.INFO); }
    public void addHint         (String m,String h,int ln,int col,int s,int e){ add(m,h,ln,col,s,e,CodeError.Severity.HINT); }
    
    public List<CodeError> getErrors() { 
        List<CodeError> out=new ArrayList<>(errors); 
        Collections.sort(out); 
        return out; 
    }
    
    public boolean hasErrors()  { 
        return errors.stream().anyMatch(e->e.severity==CodeError.Severity.ERROR); 
    }
    
    public boolean hasIssues()  { 
        return !errors.isEmpty(); 
    }
    
    public void clear() { 
        errors.clear(); 
        dedup.clear(); 
    }
    
    public int getErrorCount() { 
        return (int)errors.stream().filter(e->e.severity==CodeError.Severity.ERROR).count(); 
    }
    
    public int getWarningCount(){ 
        return (int)errors.stream().filter(e->e.severity==CodeError.Severity.WARNING).count(); 
    }
    
    public int getInfoCount() { 
        return (int)errors.stream().filter(e->e.severity==CodeError.Severity.INFO||e.severity==CodeError.Severity.HINT).count(); 
    }
}

// ============================================================================
// JAVA LEXER
// ============================================================================
class JavaLexer {
    private final String source;
    private int pos, line, column;
    private final List<Token> tokens = new ArrayList<>();

    public JavaLexer(String src) { 
        this.source=src!=null?src:""; 
        this.pos=0; 
        this.line=1; 
        this.column=1; 
    }

    public List<Token> tokenize() {
        tokens.clear();
        while (pos < source.length()) {
            char ch = source.charAt(pos);
            if (ch==' '||ch=='\t'||ch=='\r') { advance(); continue; }
            if (ch=='\n') { addToken(TokenRepository.TokenType.NEWLINE,"\n"); advance(); line++; column=1; continue; }
            if (ch=='/'&&peek()=='/') { lexLineComment(); continue; }
            if (ch=='/'&&peek()=='*') { lexBlockComment(); continue; }
            if (ch=='"') {
                if (pos+2<source.length()&&source.charAt(pos+1)=='"'&&source.charAt(pos+2)=='"') lexTextBlock();
                else lexString();
                continue;
            }
            if (ch=='\'') { lexChar(); continue; }
            if (Character.isDigit(ch)||(ch=='.'&&pos+1<source.length()&&Character.isDigit(source.charAt(pos+1)))) { lexNumber(); continue; }
            if (Character.isJavaIdentifierStart(ch)) { lexIdentifier(); continue; }
            if (!lexOperatorOrSymbol()) advance();
        }
        tokens.add(new Token(TokenRepository.TokenType.EOF,"",line,column,pos,pos));
        return tokens;
    }

    private void lexLineComment() {
        int s=pos,sl=line,sc=column; 
        StringBuilder sb=new StringBuilder();
        while (pos<source.length()&&source.charAt(pos)!='\n') { 
            sb.append(source.charAt(pos)); 
            advance(); 
        }
        tokens.add(new Token(TokenRepository.TokenType.LINE_COMMENT,sb.toString(),sl,sc,s,pos));
    }
    
    private void lexBlockComment() {
        int s=pos,sl=line,sc=column; 
        StringBuilder sb=new StringBuilder();
        sb.append("/*"); advance(); advance();
        while (pos<source.length()-1&&!(source.charAt(pos)=='*'&&source.charAt(pos+1)=='/')) {
            if (source.charAt(pos)=='\n') { line++; column=1; }
            sb.append(source.charAt(pos)); advance();
        }
        if (pos<source.length()-1) { sb.append("*/"); advance(); advance(); }
        TokenRepository.TokenType t = sb.toString().startsWith("/**") ? TokenRepository.TokenType.JAVADOC_COMMENT : TokenRepository.TokenType.BLOCK_COMMENT;
        tokens.add(new Token(t,sb.toString(),sl,sc,s,pos));
    }
    
    private void lexString() {
        int s=pos,sl=line,sc=column; 
        StringBuilder sb=new StringBuilder();
        sb.append('"'); advance();
        while (pos<source.length()&&source.charAt(pos)!='"'&&source.charAt(pos)!='\n') {
            if (source.charAt(pos)=='\\') { 
                sb.append(source.charAt(pos)); advance(); 
                if (pos<source.length()) { sb.append(source.charAt(pos)); advance(); } 
            } else { 
                sb.append(source.charAt(pos)); advance(); 
            }
        }
        if (pos<source.length()&&source.charAt(pos)=='"') { sb.append('"'); advance(); }
        tokens.add(new Token(TokenRepository.TokenType.STRING_LITERAL,sb.toString(),sl,sc,s,pos));
    }
    
    private void lexTextBlock() {
        int s=pos,sl=line,sc=column; 
        StringBuilder sb=new StringBuilder();
        sb.append("\"\"\""); advance(); advance(); advance();
        while (pos<source.length()-2&&!(source.charAt(pos)=='"'&&source.charAt(pos+1)=='"'&&source.charAt(pos+2)=='"')) {
            if (source.charAt(pos)=='\n') { line++; column=1; }
            sb.append(source.charAt(pos)); advance();
        }
        if (pos<source.length()-2) { sb.append("\"\"\""); advance(); advance(); advance(); }
        tokens.add(new Token(TokenRepository.TokenType.TEXT_BLOCK,sb.toString(),sl,sc,s,pos));
    }
    
    private void lexChar() {
        int s=pos,sl=line,sc=column; 
        StringBuilder sb=new StringBuilder();
        sb.append('\''); advance();
        if (pos<source.length()) {
            if (source.charAt(pos)=='\\') { 
                sb.append(source.charAt(pos)); advance(); 
                if (pos<source.length()) { sb.append(source.charAt(pos)); advance(); } 
            } else if (source.charAt(pos)!='\'') { 
                sb.append(source.charAt(pos)); advance(); 
            }
        }
        while (pos<source.length()&&source.charAt(pos)!='\''&&source.charAt(pos)!='\n') { 
            sb.append(source.charAt(pos)); advance(); 
        }
        if (pos<source.length()&&source.charAt(pos)=='\'') { 
            sb.append('\''); advance(); 
        }
        tokens.add(new Token(TokenRepository.TokenType.CHAR_LITERAL,sb.toString(),sl,sc,s,pos));
    }
    
    private void lexNumber() {
        int s=pos,sl=line,sc=column; 
        StringBuilder sb=new StringBuilder(); 
        boolean isFloat=false;
        
        if (pos<source.length()&&source.charAt(pos)=='0'&&pos+1<source.length()&&(source.charAt(pos+1)=='x'||source.charAt(pos+1)=='X')) {
            sb.append(source.charAt(pos)); advance(); sb.append(source.charAt(pos)); advance();
            while (pos<source.length()&&(Character.isDigit(source.charAt(pos))||"abcdefABCDEF_".indexOf(source.charAt(pos))>=0)) { 
                sb.append(source.charAt(pos)); advance(); 
            }
        } else {
            while (pos<source.length()&&(Character.isDigit(source.charAt(pos))||source.charAt(pos)=='.'||source.charAt(pos)=='_')) {
                if (source.charAt(pos)=='.') isFloat=true;
                sb.append(source.charAt(pos)); advance();
            }
        }
        if (pos<source.length()) {
            char sfx=source.charAt(pos);
            if (sfx=='f'||sfx=='F'||sfx=='d'||sfx=='D'||sfx=='l'||sfx=='L') { 
                sb.append(sfx); advance(); 
                if (sfx=='f'||sfx=='F'||sfx=='d'||sfx=='D') isFloat=true; 
            }
        }
        String v=sb.toString();
        TokenRepository.TokenType t=(v.endsWith("f")||v.endsWith("F"))?TokenRepository.TokenType.FLOAT_LITERAL:
            (v.endsWith("d")||v.endsWith("D"))?TokenRepository.TokenType.DOUBLE_LITERAL:
            (v.endsWith("l")||v.endsWith("L"))?TokenRepository.TokenType.LONG_LITERAL:
            isFloat?TokenRepository.TokenType.DOUBLE_LITERAL:TokenRepository.TokenType.INTEGER_LITERAL;
        tokens.add(new Token(t,v,sl,sc,s,pos));
    }
    
    private void lexIdentifier() {
        int s=pos,sl=line,sc=column; 
        StringBuilder sb=new StringBuilder();
        while (pos<source.length()&&Character.isJavaIdentifierPart(source.charAt(pos))) { 
            sb.append(source.charAt(pos)); advance(); 
        }
        String word=sb.toString();
        tokens.add(new Token(TokenRepository.getKeywordType(word),word,sl,sc,s,pos));
    }
    
    private boolean lexOperatorOrSymbol() {
        int s=pos; char ch=source.charAt(pos);
        String two=pos+1<source.length()?source.substring(pos,pos+2):"";
        String three=pos+2<source.length()?source.substring(pos,pos+3):"";
        String four=pos+3<source.length()?source.substring(pos,pos+4):"";
        
        TokenRepository.TokenType type=null; 
        String val=null; 
        int len=0;
        
        if (">>>=".equals(four)) { type=TokenRepository.TokenType.URSHIFT_EQUAL; val=">>>="; len=4; }
        else if (">>>".equals(three)) { type=TokenRepository.TokenType.URSHIFT; val=">>>"; len=3; }
        else if ("<<=".equals(three)) { type=TokenRepository.TokenType.LSHIFT_EQUAL; val="<<="; len=3; }
        else if (">>=".equals(three)) { type=TokenRepository.TokenType.RSHIFT_EQUAL; val=">>="; len=3; }
        else if ("...".equals(three)) { type=TokenRepository.TokenType.ELLIPSIS; val="..."; len=3; }
        else {
            type=TokenRepository.getOperatorType(two);
            if (type!=null) { val=two; len=2; }
            else {
                type=TokenRepository.getSymbolType(ch);
                if (type==null) type=TokenRepository.getOperatorType(String.valueOf(ch));
                if (type!=null) { val=String.valueOf(ch); len=1; }
            }
        }
        
        if (type!=null) { 
            tokens.add(new Token(type,val,line,column,s,s+len)); 
            for (int i=0;i<len;i++) advance(); 
            return true; 
        }
        return false;
    }
    
    private void addToken(TokenRepository.TokenType t,String v) { 
        tokens.add(new Token(t,v,line,column,pos,pos+v.length())); 
    }
    
    private char peek() { 
        return pos+1<source.length()?source.charAt(pos+1):'\0'; 
    }
    
    private void advance() { 
        if (pos<source.length()) { pos++; column++; } 
    }
}

// ============================================================================
// JAVA PARSER
// ============================================================================
class JavaParser {
    private final List<Token> tokens;
    private int pos;
    private final ErrorManager em;

    public JavaParser(List<Token> tokens, ErrorManager em) { 
        this.tokens=tokens; 
        this.pos=0; 
        this.em=em; 
    }

    public ASTNode parse() {
        ASTNode root=new ASTNode(ASTNode.NodeType.COMPILATION_UNIT,"root",1,0,0);
        skipComments();
        if (check(TokenRepository.TokenType.PACKAGE)) { 
            advance(); 
            root.addChild(parsePackageDecl()); 
        }
        skipComments();
        while (check(TokenRepository.TokenType.IMPORT)) { 
            advance(); 
            root.addChild(parseImportDecl()); 
            skipComments(); 
        }
        while (!isEOF()) { 
            skipComments(); 
            if (isEOF()) break; 
            if (isTypeDeclarationStart()) root.addChild(parseTypeDecl()); 
            else advance(); 
        }
        return root;
    }
    
    private ASTNode parsePackageDecl() {
        int ln=current().line; 
        StringBuilder name=new StringBuilder();
        while (!check(TokenRepository.TokenType.SEMICOLON)&&!isEOF()) { 
            name.append(current().value); 
            advance(); 
        }
        if (check(TokenRepository.TokenType.SEMICOLON)) advance();
        return new ASTNode(ASTNode.NodeType.PACKAGE_DECLARATION,name.toString().trim(),ln,0,0);
    }
    
    private ASTNode parseImportDecl() {
        int ln=current().line; 
        StringBuilder name=new StringBuilder();
        while (!check(TokenRepository.TokenType.SEMICOLON)&&!isEOF()) { 
            name.append(current().value); 
            advance(); 
        }
        if (check(TokenRepository.TokenType.SEMICOLON)) advance();
        return new ASTNode(ASTNode.NodeType.IMPORT_DECLARATION,name.toString().trim(),ln,0,0);
    }
    
    private ASTNode parseTypeDecl() {
        while (current().isModifier()) advance();
        ASTNode.NodeType kind=ASTNode.NodeType.CLASS_DECLARATION;
        if (check(TokenRepository.TokenType.INTERFACE)) { advance(); kind=ASTNode.NodeType.INTERFACE_DECLARATION; }
        else if (check(TokenRepository.TokenType.ENUM)) { advance(); kind=ASTNode.NodeType.ENUM_DECLARATION; }
        else if (check(TokenRepository.TokenType.CLASS)) { advance(); }
        else { advance(); return null; }
        
        Token nameToken=null;
        if (check(TokenRepository.TokenType.IDENTIFIER)||current().isType()) { 
            nameToken=advance(); 
        }
        String cname=nameToken!=null?nameToken.value:"Unknown";
        int cline=nameToken!=null?nameToken.line:0;
        ASTNode node=new ASTNode(kind,cname,cline,0,0);
        
        while (!check(TokenRepository.TokenType.LBRACE)&&!isEOF()) advance();
        if (check(TokenRepository.TokenType.LBRACE)) {
            advance(); int depth=1;
            while (depth>0&&!isEOF()) {
                if (check(TokenRepository.TokenType.LBRACE)) { depth++; advance(); }
                else if (check(TokenRepository.TokenType.RBRACE)) { depth--; advance(); }
                else advance();
            }
        } else {
            em.addSyntaxError("Expected '{' for type body","Add opening brace '{'",current().line,current().column,current().startOffset,current().endOffset);
        }
        return node;
    }
    
    private boolean isTypeDeclarationStart() {
        TokenRepository.TokenType t=current().type;
        return t==TokenRepository.TokenType.CLASS||t==TokenRepository.TokenType.INTERFACE
            ||t==TokenRepository.TokenType.ENUM||current().isModifier()||t==TokenRepository.TokenType.AT;
    }
    
    private Token current() { return pos<tokens.size()?tokens.get(pos):new Token(TokenRepository.TokenType.EOF,"",0,0,0,0); }
    private Token advance() { Token t=current(); if (pos<tokens.size()) pos++; skipComments(); return t; }
    private boolean check(TokenRepository.TokenType t) { return current().type==t; }
    private boolean isEOF() { return current().type==TokenRepository.TokenType.EOF; }
    private void skipComments() { while (!isEOF()&&current().isComment()) pos++; }
}

// ============================================================================
// SEMANTIC ANALYZER 
// ============================================================================
class SemanticAnalyzer {
    private final ErrorManager em;
    private final String source;
    private final List<Token> tokens;
    private final List<Token> code;
    private final Set<Integer> packageImportLines = new HashSet<>();
    private final Set<String> classFieldNames = new HashSet<>();

    public SemanticAnalyzer(String source, List<Token> tokens, ASTNode ast, ErrorManager em) {
        this.source = source;
        this.em = em;
        this.tokens = tokens;
        this.code = new ArrayList<>();
        for (Token t : tokens) {
            if (!t.isComment() && t.type != TokenRepository.TokenType.WHITESPACE
                    && t.type != TokenRepository.TokenType.NEWLINE) {
                code.add(t);
            }
        }
        buildPackageImportLines();
    }

    private void buildPackageImportLines() {
        for (int i = 0; i < code.size(); i++) {
            Token t = code.get(i);
            if (t.type == TokenRepository.TokenType.PACKAGE || t.type == TokenRepository.TokenType.IMPORT) {
                packageImportLines.add(t.line);
                for (int j = i + 1; j < code.size(); j++) {
                    packageImportLines.add(code.get(j).line);
                    if (code.get(j).type == TokenRepository.TokenType.SEMICOLON) break;
                }
            }
        }
    }

    public void analyze() {
        if (code.isEmpty()) return;
        checkLexicalErrors();
        checkBracketMatching();
        checkModifierConflicts();
        checkDuplicateVariablesInScope();
        checkClassFieldDuplicates();
        checkDivisionByZero();
        checkReturnVoid();
        checkEmptyBlocks();
        checkTypos();
        checkStringEquality();
        checkNullToPrimitive();
        checkInfiniteWhileTrue();
        checkEmptyCatchBlocks();
        validateImports();
    }

    private void checkLexicalErrors() {
        for (Token t : tokens) {
            if (t.type == TokenRepository.TokenType.STRING_LITERAL) {
                if (!t.value.endsWith("\"") || t.value.length() < 2)
                    em.addSyntaxError("Unterminated string literal", "Close the string with a double-quote (\")", t.line, t.column, t.startOffset, t.endOffset);
            }
            if (t.type == TokenRepository.TokenType.CHAR_LITERAL) {
                String v = t.value;
                boolean badClose = !v.endsWith("'");
                boolean tooShort = v.length() < 3;
                boolean tooLong = v.startsWith("'\\") ? v.length() > 4 : v.length() > 3;
                if (badClose || tooShort || tooLong)
                    em.addSyntaxError("Invalid character literal: " + v, "A char literal holds exactly one character, e.g. 'A' or '\\n'", t.line, t.column, t.startOffset, t.endOffset);
            }
        }
    }

    private void checkBracketMatching() {
        Stack<Token> stack = new Stack<>();
        for (Token t : code) {
            switch (t.type) {
                case LBRACE: case LPAREN: case LBRACKET: stack.push(t); break;
                case RBRACE: case RPAREN: case RBRACKET:
                    if (stack.isEmpty()) {
                        em.addSyntaxError("Unmatched closing '" + t.value + "'", "Remove or add opening '" + mirror(t.value) + "'", t.line, t.column, t.startOffset, t.endOffset);
                    } else {
                        Token open = stack.pop();
                        if (!isPair(open, t)) {
                            em.addSyntaxError("Mismatched brackets: '" + open.value + "' closed by '" + t.value + "'",
                                    "Replace with '" + closingOf(open) + "'", t.line, t.column, t.startOffset, t.endOffset);
                        }
                    }
                    break;
                default: break;
            }
        }
        while (!stack.isEmpty()) {
            Token open = stack.pop();
            em.addSyntaxError("Unclosed '" + open.value + "'", "Add closing '" + closingOf(open) + "'", open.line, open.column, open.startOffset, open.endOffset);
        }
    }

    private String mirror(String close) { return close.equals("}") ? "{" : close.equals(")") ? "(" : "["; }
    private String closingOf(Token open) { return open.type == TokenRepository.TokenType.LBRACE ? "}" : open.type == TokenRepository.TokenType.LPAREN ? ")" : "]"; }
    
    private boolean isPair(Token open, Token close) {
        return (open.type == TokenRepository.TokenType.LBRACE && close.type == TokenRepository.TokenType.RBRACE)
                || (open.type == TokenRepository.TokenType.LPAREN && close.type == TokenRepository.TokenType.RPAREN)
                || (open.type == TokenRepository.TokenType.LBRACKET && close.type == TokenRepository.TokenType.RBRACKET);
    }

    private void checkModifierConflicts() {
        for (int i = 0; i < code.size(); i++) {
            Token t = code.get(i);
            if (t.type == TokenRepository.TokenType.ABSTRACT) {
                for (int j = i + 1; j < Math.min(i + 12, code.size()); j++) {
                    TokenRepository.TokenType jt = code.get(j).type;
                    if (jt == TokenRepository.TokenType.FINAL) {
                        em.addSemanticError("Conflicting modifiers: 'abstract' and 'final'", "Remove one", code.get(j).line, code.get(j).column, code.get(j).startOffset, code.get(j).endOffset);
                        break;
                    }
                    if (jt == TokenRepository.TokenType.IDENTIFIER || jt == TokenRepository.TokenType.LBRACE) break;
                }
                for (int j = i + 1; j < Math.min(i + 12, code.size()); j++) {
                    TokenRepository.TokenType jt = code.get(j).type;
                    if (jt == TokenRepository.TokenType.STATIC) {
                        em.addSemanticError("Conflicting modifiers: 'abstract' and 'static'", "Remove one", code.get(j).line, code.get(j).column, code.get(j).startOffset, code.get(j).endOffset);
                        break;
                    }
                    if (jt == TokenRepository.TokenType.IDENTIFIER || jt == TokenRepository.TokenType.LBRACE) break;
                }
            }
        }
    }

    private void checkDuplicateVariablesInScope() {
        List<Set<String>> scopeVars = new ArrayList<>();
        scopeVars.add(new HashSet<>());
        int depth = 0;
        int paren = 0;
        for (int i = 0; i < code.size(); i++) {
            Token t = code.get(i);
            if (t.type == TokenRepository.TokenType.LBRACE) {
                depth++;
                scopeVars.add(new HashSet<>());
            } else if (t.type == TokenRepository.TokenType.RBRACE) {
                if (depth > 0) { scopeVars.remove(depth); depth--; }
            } else if (t.type == TokenRepository.TokenType.LPAREN) {
                paren++;
            } else if (t.type == TokenRepository.TokenType.RPAREN) {
                if (paren > 0) paren--;
            }
            if (depth < 2 || paren > 0) continue;
            if (t.isType() && i + 2 < code.size()) {
                Token next = code.get(i + 1);
                if (next.type == TokenRepository.TokenType.IDENTIFIER) {
                    TokenRepository.TokenType after = code.get(i + 2).type;
                    boolean isDecl = after == TokenRepository.TokenType.EQUAL || after == TokenRepository.TokenType.SEMICOLON
                            || after == TokenRepository.TokenType.COMMA || after == TokenRepository.TokenType.RPAREN
                            || after == TokenRepository.TokenType.LBRACKET;
                    if (isDecl && depth < scopeVars.size()) {
                        String name = next.value;
                        Set<String> cur = scopeVars.get(depth);
                        if (cur.contains(name)) {
                            em.addSemanticError("Duplicate variable '" + name + "' in the same scope", "Rename this variable or reuse the existing one", next.line, next.column, next.startOffset, next.endOffset);
                        } else {
                            cur.add(name);
                        }
                    }
                }
            }
        }
    }

    private void checkClassFieldDuplicates() {
        int depth = 0, paren = 0;
        for (int i = 0; i < code.size(); i++) {
            Token t = code.get(i);
            if (t.type == TokenRepository.TokenType.LBRACE) {
                if (depth == 0) classFieldNames.clear();
                depth++;
            } else if (t.type == TokenRepository.TokenType.RBRACE) {
                if (depth > 0) depth--;
            } else if (t.type == TokenRepository.TokenType.LPAREN) {
                paren++;
            } else if (t.type == TokenRepository.TokenType.RPAREN) {
                if (paren > 0) paren--;
            }
            if (depth != 1 || paren > 0) continue;
            if (t.isType() && i + 1 < code.size()) {
                Token next = code.get(i + 1);
                if (next.type == TokenRepository.TokenType.IDENTIFIER && i + 2 < code.size()) {
                    TokenRepository.TokenType after = code.get(i + 2).type;
                    boolean isDecl = after == TokenRepository.TokenType.EQUAL || after == TokenRepository.TokenType.SEMICOLON || after == TokenRepository.TokenType.COMMA;
                    if (isDecl) {
                        String name = next.value;
                        if (classFieldNames.contains(name)) {
                            em.addSemanticError("Duplicate field '" + name + "'", "Rename one of the fields", next.line, next.column, next.startOffset, next.endOffset);
                        } else {
                            classFieldNames.add(name);
                        }
                    }
                }
            }
        }
    }

    private void checkDivisionByZero() {
        for (int i = 0; i + 1 < code.size(); i++) {
            if (code.get(i).type == TokenRepository.TokenType.SLASH) {
                Token divisor = code.get(i + 1);
                boolean isZero = false;
                if (divisor.type == TokenRepository.TokenType.INTEGER_LITERAL) {
                    isZero = divisor.value.replace("_", "").equals("0");
                } else if (divisor.type == TokenRepository.TokenType.DOUBLE_LITERAL || divisor.type == TokenRepository.TokenType.FLOAT_LITERAL) {
                    try { isZero = Double.parseDouble(divisor.value.replaceAll("[fFdDlL]", "")) == 0.0; } catch (NumberFormatException ignored) {}
                }
                if (isZero) em.addWarning("Division by zero", "Will throw ArithmeticException at runtime", divisor.line, divisor.column, divisor.startOffset, divisor.endOffset);
            }
        }
    }

    private void checkReturnVoid() {
        for (int i = 0; i + 1 < code.size(); i++) {
            if (code.get(i).type == TokenRepository.TokenType.RETURN && code.get(i + 1).type == TokenRepository.TokenType.VOID) {
                em.addSemanticError("Cannot use 'void' as a return value", "Use  return;  (with no value)", code.get(i + 1).line, code.get(i + 1).column, code.get(i).startOffset, code.get(i + 1).endOffset);
            }
        }
    }

    private void checkEmptyBlocks() {
        for (int i = 0; i + 1 < code.size(); i++) {
            if (code.get(i).type == TokenRepository.TokenType.LBRACE && code.get(i + 1).type == TokenRepository.TokenType.RBRACE) {
                if (i > 0 && (code.get(i - 1).type == TokenRepository.TokenType.RPAREN || code.get(i - 1).type == TokenRepository.TokenType.COMMA
                        || code.get(i - 1).type == TokenRepository.TokenType.EQUAL || code.get(i - 1).type == TokenRepository.TokenType.NEW)) continue;
                em.addInfo("Empty block detected", "Consider adding code or a comment inside, e.g.  { /* intentionally empty */ }", code.get(i).line, code.get(i).column, code.get(i).startOffset, code.get(i + 1).endOffset);
            }
        }
    }

    private void checkTypos() {
        Set<String> dict = new HashSet<>(TokenRepository.getAllKeywords());
        dict.addAll(TokenRepository.BUILTIN_TYPES);
        dict.addAll(Arrays.asList("i","j","k","x","y","z","n","s","c","m","v","p","q","r","a","b","d","e","f","g","h",
                "name","index","count","value","data","result","message","file","path","list","map","set","key","entry",
                "output","input","number","size","length","position","state","buffer","source","target","element","item","flag",
                "ignored","ignore","unused"));
        Map<String, Integer> freq = new HashMap<>();
        for (Token t : code) { if (t.type == TokenRepository.TokenType.IDENTIFIER) freq.merge(t.value, 1, Integer::sum); }
        for (Map.Entry<String, Integer> e : freq.entrySet()) { if (e.getValue() > 1) dict.add(e.getKey()); }
        for (int i = 0; i < code.size(); i++) {
            Token t = code.get(i);
            if (t.type != TokenRepository.TokenType.IDENTIFIER) continue;
            if (dict.contains(t.value) || freq.getOrDefault(t.value, 0) > 1) continue;
            if (t.value.length() < 5 || Character.isUpperCase(t.value.charAt(0)) || t.value.toUpperCase().equals(t.value)) continue;
            if (i + 1 < code.size() && (code.get(i + 1).type == TokenRepository.TokenType.LPAREN || code.get(i + 1).type == TokenRepository.TokenType.DOT)) continue;
            String closest = null; int minDist = Integer.MAX_VALUE;
            for (String word : dict) {
                if (Math.abs(word.length() - t.value.length()) > 2) continue;
                int dist = levenshtein(t.value, word);
                if (dist < minDist) { minDist = dist; closest = word; }
            }
            if (closest != null && minDist == 1) em.addWarning("Possible typo: '" + t.value + "'", "Did you mean '" + closest + "'?", t.line, t.column, t.startOffset, t.endOffset);
        }
    }

    private int levenshtein(String a, String b) {
        int[] costs = new int[b.length() + 1];
        for (int j = 0; j < costs.length; j++) costs[j] = j;
        for (int i = 1; i <= a.length(); i++) {
            costs[0] = i; int nw = i - 1;
            for (int j = 1; j <= b.length(); j++) {
                int cj = Math.min(1 + Math.min(costs[j], costs[j - 1]), a.charAt(i - 1) == b.charAt(j - 1) ? nw : nw + 1);
                nw = costs[j]; costs[j] = cj;
            }
        }
        return costs[b.length()];
    }

    private void checkStringEquality() {
        for (int i = 1; i + 1 < code.size(); i++) {
            if (code.get(i).type == TokenRepository.TokenType.EQUAL_EQUAL || code.get(i).type == TokenRepository.TokenType.NOT_EQUAL) {
                if (code.get(i + 1).type == TokenRepository.TokenType.STRING_LITERAL)
                    em.addWarning("Comparing String with '==' or '!=' may give unexpected results", "Use .equals() instead", code.get(i).line, code.get(i).column, code.get(i).startOffset, code.get(i).endOffset);
            }
        }
    }

    private void checkNullToPrimitive() {
        Set<String> primitives = new HashSet<>(Arrays.asList("byte","short","int","long","float","double","boolean","char"));
        for (int i = 1; i + 2 < code.size(); i++) {
            if (code.get(i).type == TokenRepository.TokenType.EQUAL && code.get(i - 1).type == TokenRepository.TokenType.IDENTIFIER) {
                Token typeTok = i - 2 >= 0 ? code.get(i - 2) : null;
                if (typeTok != null && primitives.contains(typeTok.value) && code.get(i + 1).type == TokenRepository.TokenType.NULL)
                    em.addError("Cannot assign null to primitive type '" + typeTok.value + "'", "Use a default value instead (e.g. 0)", code.get(i + 1).line, code.get(i + 1).column, code.get(i + 1).startOffset, code.get(i + 1).endOffset, CodeError.Severity.ERROR);
            }
        }
    }

    private void checkInfiniteWhileTrue() {
        for (int i = 0; i + 3 < code.size(); i++) {
            if (code.get(i).value.equals("while") && code.get(i + 1).type == TokenRepository.TokenType.LPAREN
                    && code.get(i + 2).value.equals("true") && code.get(i + 3).type == TokenRepository.TokenType.RPAREN) {
                int j = i + 4;
                if (j < code.size() && code.get(j).type == TokenRepository.TokenType.LBRACE) {
                    int depth = 1, k = j + 1;
                    boolean hasExit = false;
                    while (k < code.size() && depth > 0) {
                        if (code.get(k).type == TokenRepository.TokenType.LBRACE) depth++;
                        else if (code.get(k).type == TokenRepository.TokenType.RBRACE) depth--;
                        else if (code.get(k).value.equals("break") || code.get(k).value.equals("return")) { hasExit = true; break; }
                        k++;
                    }
                    if (!hasExit) em.addWarning("Possible infinite loop: 'while(true)' with no break or return inside", "Add a break or return to exit the loop", code.get(i).line, code.get(i).column, code.get(i).startOffset, code.get(i).endOffset);
                }
            }
        }
    }

    private void checkEmptyCatchBlocks() {
        for (int i = 0; i + 1 < code.size(); i++) {
            if (code.get(i).value.equals("catch") && code.get(i + 1).type == TokenRepository.TokenType.LPAREN) {
                int j = i + 1;
                while (j < code.size() && code.get(j).type != TokenRepository.TokenType.RPAREN) j++;
                j++;
                if (j < code.size() && code.get(j).type == TokenRepository.TokenType.LBRACE && j + 1 < code.size() && code.get(j + 1).type == TokenRepository.TokenType.RBRACE) {
                    int nameIdx = j - 2;
                    if (nameIdx > i && code.get(nameIdx).type == TokenRepository.TokenType.IDENTIFIER) {
                        String name = code.get(nameIdx).value;
                        if (name.equals("ignored") || name.equals("ignore") || name.equals("unused")) continue;
                    }
                    em.addWarning("Empty catch block — exception is silently swallowed", "Log the exception or handle it explicitly", code.get(j).line, code.get(j).column, code.get(j).startOffset, code.get(j + 1).endOffset);
                }
            }
        }
    }

    private void validateImports() {
        String[] lines = source.split("\n");
        for (int i = 0; i < lines.length; i++) {
            String ln = lines[i].trim();
            if (ln.startsWith("import ")) {
                Matcher imp = Pattern.compile("import\\s+(static\\s+)?([a-zA-Z0-9_.]+)(\\.\\*)?\\s*;").matcher(ln);
                if (imp.find()) {
                    String pkgClass = imp.group(2);
                    String pkg = imp.group(3) != null ? pkgClass : (pkgClass.contains(".") ? pkgClass.substring(0, pkgClass.lastIndexOf('.')) : pkgClass);
                    if (pkg.startsWith("java.") || pkg.startsWith("javax.") || pkg.startsWith("org.")) continue;
                }
            }
        }
    }
}

class JavaErrorChecker {
    private final ErrorManager em = new ErrorManager();

    public ErrorManager checkCode(String src) {
        em.clear();
        if (src == null || src.trim().isEmpty()) { 
            em.addInfo("No code to check", "Open or create a Java file to begin", 1, 1, 0, 0); 
            return em; 
        }
        try {
            JavaLexer lexer = new JavaLexer(src);
            List<Token> tokens = lexer.tokenize();
            JavaParser parser = new JavaParser(tokens, em);
            ASTNode ast = parser.parse();
            SemanticAnalyzer sa = new SemanticAnalyzer(src, tokens, ast, em);
            sa.analyze();
        } catch (Exception ex) {
            em.addError("Internal analysis error: " + ex.getMessage(), "Please report this issue", 0, 0, 0, 0, CodeError.Severity.ERROR);
        }
        return em;
    }
}

