    private void toggleSidebar() {
        sidebarVisible = !sidebarVisible;
        if (sidebarVisible) {
            fileExplorer.setVisible(true);
            mainSplit.setDividerLocation(220);
        } else {
            fileExplorer.setVisible(false);
            mainSplit.setDividerLocation(0);
        }
        mainSplit.revalidate();
        mainSplit.repaint();
