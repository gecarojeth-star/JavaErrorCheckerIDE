    public static TokenType getKeywordType(String kw)  { 
        return KEYWORD_MAP.getOrDefault(kw, TokenType.IDENTIFIER); 
    }
    
    public static TokenType getOperatorType(String op) { 
        return OPERATOR_MAP.get(op); 
    }
    
    public static TokenType getSymbolType(char sym)    { 
        return SYMBOL_MAP.get(sym); 
    }
    
    public static boolean isJavaKeyword(String word) { 
        return KEYWORD_MAP.containsKey(word) && KEYWORD_MAP.get(word)!=TokenType.TYPE_IDENTIFIER; 
    }
    
    public static Set<String> getAllKeywords() {
        Set<String> out = new HashSet<>();
        for (Map.Entry<String,TokenType> e : KEYWORD_MAP.entrySet()) {
            if (e.getValue()!=TokenType.TYPE_IDENTIFIER) {
                out.add(e.getKey());
            }
        }
        return out;
    }
