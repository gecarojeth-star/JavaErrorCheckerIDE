// ============================================================================
class TokenRepository {
    public enum TokenCategory { KEYWORD, IDENTIFIER, LITERAL, OPERATOR, SYMBOL, COMMENT, WHITESPACE, EOF }

    public enum TokenType {
        PUBLIC("public", TokenCategory.KEYWORD), PRIVATE("private", TokenCategory.KEYWORD),
        PROTECTED("protected", TokenCategory.KEYWORD), STATIC("static", TokenCategory.KEYWORD),
        FINAL("final", TokenCategory.KEYWORD), ABSTRACT("abstract", TokenCategory.KEYWORD),
        SYNCHRONIZED("synchronized", TokenCategory.KEYWORD), TRANSIENT("transient", TokenCategory.KEYWORD),
        VOLATILE("volatile", TokenCategory.KEYWORD), NATIVE("native", TokenCategory.KEYWORD),
        STRICTFP("strictfp", TokenCategory.KEYWORD), DEFAULT("default", TokenCategory.KEYWORD),
        BYTE("byte", TokenCategory.KEYWORD), SHORT("short", TokenCategory.KEYWORD),
        INT("int", TokenCategory.KEYWORD), LONG("long", TokenCategory.KEYWORD),
        FLOAT("float", TokenCategory.KEYWORD), DOUBLE("double", TokenCategory.KEYWORD),
        BOOLEAN("boolean", TokenCategory.KEYWORD), CHAR("char", TokenCategory.KEYWORD),
        VOID("void", TokenCategory.KEYWORD), CLASS("class", TokenCategory.KEYWORD),
        INTERFACE("interface", TokenCategory.KEYWORD), ENUM("enum", TokenCategory.KEYWORD),
        EXTENDS("extends", TokenCategory.KEYWORD), IMPLEMENTS("implements", TokenCategory.KEYWORD),
        NEW("new", TokenCategory.KEYWORD), SUPER("super", TokenCategory.KEYWORD),
        THIS("this", TokenCategory.KEYWORD), INSTANCEOF("instanceof", TokenCategory.KEYWORD),
        IF("if", TokenCategory.KEYWORD), ELSE("else", TokenCategory.KEYWORD),
        SWITCH("switch", TokenCategory.KEYWORD), CASE("case", TokenCategory.KEYWORD),
        FOR("for", TokenCategory.KEYWORD), WHILE("while", TokenCategory.KEYWORD),
        DO("do", TokenCategory.KEYWORD), BREAK("break", TokenCategory.KEYWORD),
        CONTINUE("continue", TokenCategory.KEYWORD), RETURN("return", TokenCategory.KEYWORD),
        TRY("try", TokenCategory.KEYWORD), CATCH("catch", TokenCategory.KEYWORD),
        FINALLY("finally", TokenCategory.KEYWORD), THROW("throw", TokenCategory.KEYWORD),
        THROWS("throws", TokenCategory.KEYWORD), ASSERT("assert", TokenCategory.KEYWORD),
        PACKAGE("package", TokenCategory.KEYWORD), IMPORT("import", TokenCategory.KEYWORD),
        TRUE("true", TokenCategory.KEYWORD), FALSE("false", TokenCategory.KEYWORD),
        NULL("null", TokenCategory.KEYWORD), GOTO("goto", TokenCategory.KEYWORD),
        CONST("const", TokenCategory.KEYWORD),
        IDENTIFIER(null, TokenCategory.IDENTIFIER), TYPE_IDENTIFIER(null, TokenCategory.IDENTIFIER),
        INTEGER_LITERAL(null, TokenCategory.LITERAL), LONG_LITERAL(null, TokenCategory.LITERAL),
        FLOAT_LITERAL(null, TokenCategory.LITERAL), DOUBLE_LITERAL(null, TokenCategory.LITERAL),
        STRING_LITERAL(null, TokenCategory.LITERAL), CHAR_LITERAL(null, TokenCategory.LITERAL),
        TEXT_BLOCK(null, TokenCategory.LITERAL),
        PLUS("+", TokenCategory.OPERATOR), MINUS("-", TokenCategory.OPERATOR),
        STAR("*", TokenCategory.OPERATOR), SLASH("/", TokenCategory.OPERATOR),
        PERCENT("%", TokenCategory.OPERATOR), PLUS_PLUS("++", TokenCategory.OPERATOR),
        MINUS_MINUS("--", TokenCategory.OPERATOR), EQUAL("=", TokenCategory.OPERATOR),
        PLUS_EQUAL("+=", TokenCategory.OPERATOR), MINUS_EQUAL("-=", TokenCategory.OPERATOR),
        STAR_EQUAL("*=", TokenCategory.OPERATOR), SLASH_EQUAL("/=", TokenCategory.OPERATOR),
        PERCENT_EQUAL("%=", TokenCategory.OPERATOR), AND_EQUAL("&=", TokenCategory.OPERATOR),
        OR_EQUAL("|=", TokenCategory.OPERATOR), XOR_EQUAL("^=", TokenCategory.OPERATOR),
        LSHIFT_EQUAL("<<=", TokenCategory.OPERATOR), RSHIFT_EQUAL(">>=", TokenCategory.OPERATOR),
        URSHIFT_EQUAL(">>>=", TokenCategory.OPERATOR), EQUAL_EQUAL("==", TokenCategory.OPERATOR),
        NOT_EQUAL("!=", TokenCategory.OPERATOR), LESS_THAN("<", TokenCategory.OPERATOR),
        GREATER_THAN(">", TokenCategory.OPERATOR), LESS_EQUAL("<=", TokenCategory.OPERATOR),
        GREATER_EQUAL(">=", TokenCategory.OPERATOR), AND_AND("&&", TokenCategory.OPERATOR),
        OR_OR("||", TokenCategory.OPERATOR), BANG("!", TokenCategory.OPERATOR),
        AND("&", TokenCategory.OPERATOR), OR("|", TokenCategory.OPERATOR),
        XOR("^", TokenCategory.OPERATOR), TILDE("~", TokenCategory.OPERATOR),
        LSHIFT("<<", TokenCategory.OPERATOR), RSHIFT(">>", TokenCategory.OPERATOR),
        URSHIFT(">>>", TokenCategory.OPERATOR), QUESTION("?", TokenCategory.OPERATOR),
        COLON(":", TokenCategory.OPERATOR), ARROW("->", TokenCategory.OPERATOR),
        METHOD_REF("::", TokenCategory.OPERATOR),
        LPAREN("(", TokenCategory.SYMBOL), RPAREN(")", TokenCategory.SYMBOL),
        LBRACE("{", TokenCategory.SYMBOL), RBRACE("}", TokenCategory.SYMBOL),
        LBRACKET("[", TokenCategory.SYMBOL), RBRACKET("]", TokenCategory.SYMBOL),
        SEMICOLON(";", TokenCategory.SYMBOL), COMMA(",", TokenCategory.SYMBOL),
        DOT(".", TokenCategory.SYMBOL), ELLIPSIS("...", TokenCategory.SYMBOL),
        AT("@", TokenCategory.SYMBOL),
        LINE_COMMENT(null, TokenCategory.COMMENT), BLOCK_COMMENT(null, TokenCategory.COMMENT),
        JAVADOC_COMMENT(null, TokenCategory.COMMENT),
        WHITESPACE(null, TokenCategory.WHITESPACE), NEWLINE(null, TokenCategory.WHITESPACE),
        EOF(null, TokenCategory.EOF);

        private final String lexeme;
        private final TokenCategory category;
        
        TokenType(String lexeme, TokenCategory category) { 
            this.lexeme = lexeme; 
            this.category = category; 
        }
        
        public String getLexeme() { return lexeme; }
        public TokenCategory getCategory() { return category; }
        public boolean isKeyword()  { return category == TokenCategory.KEYWORD; }
        public boolean isLiteral()  { return category == TokenCategory.LITERAL; }
        public boolean isOperator() { return category == TokenCategory.OPERATOR; }
        public boolean isComment()  { return category == TokenCategory.COMMENT; }
        
        public boolean isType() {
            return this==BYTE||this==SHORT||this==INT||this==LONG||this==FLOAT||this==DOUBLE
                ||this==BOOLEAN||this==CHAR||this==VOID||this==TYPE_IDENTIFIER;
        }
        
        public boolean isModifier() {
            return this==PUBLIC||this==PRIVATE||this==PROTECTED||this==STATIC||this==FINAL
                ||this==ABSTRACT||this==SYNCHRONIZED||this==TRANSIENT||this==VOLATILE
                ||this==NATIVE||this==STRICTFP;
        }
        
        public boolean isAccessModifier() { 
            return this==PUBLIC||this==PRIVATE||this==PROTECTED; 
        }
        
        public boolean isControlFlow() {
            return this==IF||this==ELSE||this==SWITCH||this==CASE||this==DEFAULT
                ||this==FOR||this==WHILE||this==DO||this==BREAK||this==CONTINUE||this==RETURN;
        }
    }

    private static final Map<String, TokenType>    KEYWORD_MAP  = new HashMap<>();
    private static final Map<String, TokenType>    OPERATOR_MAP = new HashMap<>();
    private static final Map<Character, TokenType> SYMBOL_MAP   = new HashMap<>();

    static {
        for (TokenType t : TokenType.values()) {
            if (t.isKeyword() && t.getLexeme() != null) KEYWORD_MAP.put(t.getLexeme(), t);
            if (t.getCategory()==TokenCategory.OPERATOR && t.getLexeme()!=null) OPERATOR_MAP.put(t.getLexeme(), t);
            if (t.getCategory()==TokenCategory.SYMBOL && t.getLexeme()!=null && t.getLexeme().length()==1)
                SYMBOL_MAP.put(t.getLexeme().charAt(0), t);
        }
        KEYWORD_MAP.put("String", TokenType.TYPE_IDENTIFIER);
        KEYWORD_MAP.put("Object", TokenType.TYPE_IDENTIFIER);
        KEYWORD_MAP.put("System", TokenType.TYPE_IDENTIFIER);
    }

