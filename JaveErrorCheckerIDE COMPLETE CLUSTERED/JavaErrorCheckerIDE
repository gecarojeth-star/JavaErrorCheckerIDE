    private void updateTabColors() {
        int selected = tabbedPane.getSelectedIndex();
        for (int i = 0; i < tabbedPane.getTabCount(); i++) {
            Component tc = tabbedPane.getTabComponentAt(i);
            if (tc instanceof JPanel)
                for (Component c : ((JPanel) tc).getComponents())
                    if (c instanceof JLabel)
                        c.setForeground(i == selected ? Theme.TAB_SELECTED_FG : Theme.TAB_UNSELECTED_FG);
        }
        tabbedPane.repaint();
    }

    private void checkCode() {
        if (currentEditor == null) { status("No file open"); return; }
        String code = currentEditor.textPane.getText();
        if (code.trim().isEmpty()) { terminalPanel.clear(); status("Empty file \u2014 nothing to check"); return; }
        status("Checking\u2026");
        new Thread(() -> {
            ErrorManager em = checker.checkCode(code);
            SwingUtilities.invokeLater(() -> {
                terminalPanel.displayErrors(em);
                currentEditor.setErrors(em.getErrors());
                if (em.hasErrors())
                    status("Found " + em.getErrorCount() + " error" + (em.getErrorCount() != 1 ? "s" : "")
                        + ", " + em.getWarningCount() + " warning" + (em.getWarningCount() != 1 ? "s" : ""));
                else if (em.hasIssues())
                    status("No errors \u2014 " + em.getWarningCount() + " warning" + (em.getWarningCount() != 1 ? "s" : ""));
                else
                    status("\u2713 No issues found");
            });
        }).start();
    }

    private void newFile() {
        CodeEditor ed = new CodeEditor();
        String name = "Untitled" + (tabbedPane.getTabCount() + 1) + ".java";
        ed.textPane.addCaretListener(e -> updateCursor());
        tabbedPane.addTab(name, ed);
        tabbedPane.setSelectedComponent(ed);
        currentEditor = ed;
        terminalPanel.setCurrentEditor(ed);
        addCloseTab(tabbedPane.getTabCount() - 1, name);
        status("New file");
    }

    private void openFile() {
        JFileChooser fc = new JFileChooser();
        Theme.themeFileChooser(fc);
        fc.setFileFilter(new javax.swing.filechooser.FileFilter() {
            public boolean accept(File f) { return f.isDirectory() || f.getName().endsWith(".java"); }
            public String getDescription() { return "Java Files (*.java)"; }
        });
        if (fc.showOpenDialog(this) == JFileChooser.APPROVE_OPTION)
            openFromExplorer(fc.getSelectedFile());
    }

    private void openFromExplorer(File file) {
        for (Map.Entry<CodeEditor, File> en : editorFiles.entrySet())
            if (en.getValue().equals(file)) { tabbedPane.setSelectedComponent(en.getKey()); return; }
        try {
            String content = new String(Files.readAllBytes(file.toPath()));
            CodeEditor ed = new CodeEditor();
            ed.textPane.setText(content);
            ed.textPane.addCaretListener(e -> updateCursor());
            tabbedPane.addTab(file.getName(), ed);
            tabbedPane.setSelectedComponent(ed);
            currentEditor = ed;
            terminalPanel.setCurrentEditor(ed);
            editorFiles.put(ed, file);
            addCloseTab(tabbedPane.getTabCount() - 1, file.getName());
            status("Opened: " + file.getName());
            SyntaxHighlighter.applyHighlighting(ed.textPane);
        } catch (IOException ex) {
            JOptionPane.showMessageDialog(this, "Could not open: " + ex.getMessage(), "Error", JOptionPane.ERROR_MESSAGE);
        }
    }

    private void saveFile() {
        if (currentEditor == null) return;
        File f = editorFiles.get(currentEditor);
        if (f == null) { saveFileAs(); return; }
        try { Files.write(f.toPath(), currentEditor.textPane.getText().getBytes()); status("Saved: " + f.getName()); }
        catch (IOException ex) { status("Save error: " + ex.getMessage()); }
    }

    private void saveFileAs() {
        if (currentEditor == null) return;
        JFileChooser fc = new JFileChooser();
        Theme.themeFileChooser(fc);
        fc.setFileFilter(new javax.swing.filechooser.FileFilter() {
            public boolean accept(File f) { return f.isDirectory() || f.getName().endsWith(".java"); }
            public String getDescription() { return "Java Files (*.java)"; }
        });
        if (fc.showSaveDialog(this) == JFileChooser.APPROVE_OPTION) {
            File f = fc.getSelectedFile();
            if (!f.getName().endsWith(".java")) f = new File(f.getAbsolutePath() + ".java");
            try {
                Files.write(f.toPath(), currentEditor.textPane.getText().getBytes());
                editorFiles.put(currentEditor, f);
                int idx = tabbedPane.indexOfComponent(currentEditor);
                if (idx >= 0) {
                    tabbedPane.setTitleAt(idx, f.getName());
                    Component tc = tabbedPane.getTabComponentAt(idx);
                    if (tc instanceof JPanel)
                        for (Component c : ((JPanel) tc).getComponents())
                            if (c instanceof JLabel) ((JLabel) c).setText(f.getName() + "  ");
                }
                status("Saved as: " + f.getName());
                fileExplorer.setDirectory(f.getParentFile());
            } catch (IOException ex) { status("Save error: " + ex.getMessage()); }
        }
    }

    private void showGoToLine() {
        if (currentEditor == null) return;
        String s = JOptionPane.showInputDialog(this, "Go to line:", "Go to Line", JOptionPane.PLAIN_MESSAGE);
        if (s != null && !s.trim().isEmpty()) {
            try { currentEditor.goToLine(Integer.parseInt(s.trim())); }
            catch (NumberFormatException ex) {
                JOptionPane.showMessageDialog(this, "Enter a valid number", "Bad Input", JOptionPane.WARNING_MESSAGE);
            }
        }
    }

    private void updateCursor() {
        if (currentEditor == null) return;
        int line = currentEditor.getCurrentLine();
        int pos  = currentEditor.textPane.getCaretPosition();
        Element root = currentEditor.textPane.getDocument().getDefaultRootElement();
        if (line > 0 && line <= root.getElementCount()) {
            int col = pos - root.getElement(line - 1).getStartOffset() + 1;
            cursorLabel.setText("Ln " + line + ", Col " + col);
        }
    }

    private void status(String msg) { statusLabel.setText(msg); }

    private void addCloseTab(int index, String title) {
        JPanel panel = new JPanel(new FlowLayout(FlowLayout.LEFT, 0, 0));
        panel.setOpaque(false);
        JLabel lbl = new JLabel(title + "  ");
        lbl.setFont(Theme.UI_FONT_SMALL);
        lbl.setForeground(Theme.TAB_UNSELECTED_FG);
        JButton x = new JButton("\u00D7");
        x.setFont(new Font("Segoe UI", Font.BOLD, 13));
        x.setForeground(Theme.TEXT_MUTED);
        x.setBorder(BorderFactory.createEmptyBorder());
        x.setContentAreaFilled(false);
        x.setFocusPainted(false);
        x.setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
        x.addMouseListener(new MouseAdapter() {
            public void mouseEntered(MouseEvent e) { x.setForeground(Theme.DANGER_COLOR); }
            public void mouseExited(MouseEvent e)  { x.setForeground(Theme.TEXT_MUTED); }
        });
        x.addActionListener(e -> {
            int idx = tabbedPane.indexOfTabComponent(panel);
            if (idx >= 0) {
                Component comp = tabbedPane.getComponentAt(idx);
                tabbedPane.remove(idx);
                if (comp instanceof CodeEditor) {
                    editorFiles.remove(comp);
                    if (comp == currentEditor) currentEditor = null;
                }
                updateTabColors();
            }
        });
        panel.addMouseListener(new MouseAdapter() {
            public void mouseClicked(MouseEvent e) {
                if (e.getClickCount() == 2) {
                    int idx = tabbedPane.indexOfTabComponent(panel);
                    if (idx >= 0) {
                        Component comp = tabbedPane.getComponentAt(idx);
                        String oldTitle = lbl.getText().trim();
                        String newTitle = (String) JOptionPane.showInputDialog(
                            JavaErrorCheckerIDE.this, "Rename file:", "Rename",
                            JOptionPane.PLAIN_MESSAGE, null, null, oldTitle);
                        if (newTitle != null && !newTitle.trim().isEmpty()) {
                            if (!newTitle.endsWith(".java")) newTitle += ".java";
                            lbl.setText(newTitle + "  ");
                            tabbedPane.setTitleAt(idx, newTitle);
                            if (comp instanceof CodeEditor) {
                                File f = editorFiles.get(comp);
                                if (f != null) {
                                    File nf = new File(f.getParentFile(), newTitle);
                                    if (f.renameTo(nf)) { editorFiles.put((CodeEditor) comp, nf); status("Renamed to " + newTitle); }
                                    else status("Failed to rename file on disk.");
                                }
                            }
                        }
                    }
                }
            }
        });
        panel.add(lbl); panel.add(x);
        tabbedPane.setTabComponentAt(index, panel);
        SwingUtilities.invokeLater(this::updateTabColors);
    }

    // -----------------------------------------------------------------------
    // Keyboard shortcuts
    // -----------------------------------------------------------------------
    private void setupKeys() {
        InputMap im = getRootPane().getInputMap(JComponent.WHEN_IN_FOCUSED_WINDOW);
        ActionMap am = getRootPane().getActionMap();
        int ctrl = Toolkit.getDefaultToolkit().getMenuShortcutKeyMaskEx();

        bind(im, am, KeyEvent.VK_N,     ctrl,                                 this::newFile);
        bind(im, am, KeyEvent.VK_O,     ctrl,                                 this::openFile);
        bind(im, am, KeyEvent.VK_S,     ctrl,                                 this::saveFile);
        bind(im, am, KeyEvent.VK_S,     ctrl | InputEvent.SHIFT_DOWN_MASK,    this::saveFileAs);
        bind(im, am, KeyEvent.VK_Z,     ctrl,                                 () -> { if (currentEditor != null) currentEditor.undo(); });
        bind(im, am, KeyEvent.VK_Y,     ctrl,                                 () -> { if (currentEditor != null) currentEditor.redo(); });
        bind(im, am, KeyEvent.VK_SLASH, ctrl,                                 () -> { if (currentEditor != null) currentEditor.toggleLineComment(); });
        bind(im, am, KeyEvent.VK_G,     ctrl,                                 this::showGoToLine);
        bind(im, am, KeyEvent.VK_ENTER, ctrl,                                 this::checkCode);
        bind(im, am, KeyEvent.VK_L,     ctrl,                                 () -> terminalPanel.clear());
        bind(im, am, KeyEvent.VK_B,     ctrl,                                 this::toggleSidebar);
        bind(im, am, KeyEvent.VK_W,     ctrl,                                 () -> {
            int i = tabbedPane.getSelectedIndex();
            if (i >= 0) {
                Component c = tabbedPane.getComponentAt(i);
                tabbedPane.remove(i);
                if (c instanceof CodeEditor) { editorFiles.remove(c); if (c == currentEditor) currentEditor = null; }
                updateTabColors();
            }
        });
    }

    private void bind(InputMap im, ActionMap am, int key, int mod, Runnable r) {
        String name = "k_" + key + "_" + mod;
        im.put(KeyStroke.getKeyStroke(key, mod), name);
        am.put(name, new AbstractAction() { public void actionPerformed(ActionEvent e) { r.run(); } });
    }

