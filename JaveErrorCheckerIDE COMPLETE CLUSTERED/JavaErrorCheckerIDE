// ============================================================================
// SYNTAX HIGHLIGHTER
// ============================================================================
class SyntaxHighlighter {
    private static final Set<String> keywords  = TokenRepository.getAllKeywords();
    private static final Set<String> typeNames = new HashSet<>(Arrays.asList(
        "byte","short","int","long","float","double","boolean","char","void",
        "String","Object","System","Integer","Double","Float","Long","Boolean",
        "Character","StringBuilder","Scanner","List","Map","Set","Arrays"
    ));
    private static final Pattern TOKEN_PATTERN = Pattern.compile(
        "/\\*(?:[^*]|\\*[^/])*\\*/|//[^\n]*|@[a-zA-Z_][a-zA-Z0-9_.]*" +
        "|\"\"\"(?:[^\"\\\\]|\\\\.)*\"\"\"|\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)'"+
        "|\\b0[xX][0-9a-fA-F_]+[lL]?\\b|\\b\\d[\\d_]*\\.?[\\d_]*(?:[eE][+-]?[\\d_]+)?[fFdDlL]?\\b"+
        "|\\b[a-zA-Z_$][a-zA-Z0-9_$]*\\b"
    );

    private static Style defaultStyle, keywordStyle, typeStyle, stringStyle,
                         numberStyle, commentStyle, annotationStyle;

    public static void initStyles(JTextPane pane) {
        if (defaultStyle != null) return;
        defaultStyle    = pane.addStyle("def", null); StyleConstants.setForeground(defaultStyle,    Theme.TEXT_MAIN);
        keywordStyle    = pane.addStyle("kw",  null); StyleConstants.setForeground(keywordStyle,    Theme.KEYWORD_COLOR);
        typeStyle       = pane.addStyle("ty",  null); StyleConstants.setForeground(typeStyle,       Theme.TYPE_COLOR);
        stringStyle     = pane.addStyle("str", null); StyleConstants.setForeground(stringStyle,     Theme.STRING_COLOR);
        numberStyle     = pane.addStyle("num", null); StyleConstants.setForeground(numberStyle,     Theme.NUMBER_COLOR);
        commentStyle    = pane.addStyle("cmt", null); StyleConstants.setForeground(commentStyle,    Theme.COMMENT_COLOR);
        annotationStyle = pane.addStyle("ann", null); StyleConstants.setForeground(annotationStyle, Theme.ANNOTATION_COLOR);
    }

    public static void applyHighlighting(JTextPane pane) {
        initStyles(pane);
        StyledDocument doc = pane.getStyledDocument();
        String text;
        try { text = doc.getText(0, doc.getLength()); } catch (BadLocationException e) { return; }
        doc.setCharacterAttributes(0, text.length(), defaultStyle, false);
        Matcher m = TOKEN_PATTERN.matcher(text);
        while (m.find()) {
            String tok = m.group(); int s = m.start(); int l = tok.length();
            Style style = null;
            if      (tok.startsWith("//") || tok.startsWith("/*")) style = commentStyle;
            else if (tok.startsWith("@"))  style = annotationStyle;
            else if (tok.startsWith("\"") || tok.startsWith("'")) style = stringStyle;
            else if (Character.isDigit(tok.charAt(0))) style = numberStyle;
            else if (keywords.contains(tok)) style = typeNames.contains(tok) ? typeStyle : keywordStyle;
            if (style != null) doc.setCharacterAttributes(s, l, style, false);
        }
    }
}

// ============================================================================
// CODE EDITOR
// ============================================================================
class CodeEditor extends JPanel {
    public final JTextPane textPane;
    private final JTextPane   lineNumbers;
    private final UndoManager undoManager = new UndoManager();
    private List<CodeError>   currentErrors = new ArrayList<>();
    private final javax.swing.Timer highlightTimer;
    private int lastLineCount = -1;

    public CodeEditor() {
        setLayout(new BorderLayout());
        setBackground(Theme.APP_BG);

        textPane = new JTextPane() {
            @Override
            public boolean getScrollableTracksViewportWidth() {
                Component parent = getParent();
                return parent != null
                    ? (getUI().getPreferredSize(this).width <= parent.getSize().width)
                    : true;
            }
            @Override protected void paintComponent(Graphics g) {
                super.paintComponent(g);
                drawErrorUnderlines(g);
            }
        };
        textPane.setFont(Theme.CODE_FONT);
        textPane.setBackground(Theme.APP_BG);
        textPane.setForeground(Theme.TEXT_MAIN);
        textPane.setCaretColor(Theme.TEXT_MAIN);
        textPane.setSelectionColor(new Color(0x44475a));
        textPane.setSelectedTextColor(Theme.TEXT_MAIN);
        textPane.setBorder(BorderFactory.createEmptyBorder(4, 10, 4, 8));
        textPane.getDocument().addUndoableEditListener(e -> {
            if (!"style change".equals(e.getEdit().getPresentationName()))
                undoManager.addEdit(e.getEdit());
        });

        lineNumbers = new JTextPane();
        lineNumbers.setFont(Theme.CODE_FONT);
        lineNumbers.setBackground(Theme.SURFACE_COLOR);
        lineNumbers.setForeground(Theme.TEXT_MUTED);
        lineNumbers.setEditable(false);
        lineNumbers.setFocusable(false);
        lineNumbers.setBorder(BorderFactory.createEmptyBorder(4, 8, 4, 8));
        FontMetrics fm = lineNumbers.getFontMetrics(Theme.CODE_FONT);
        int lnw = fm.stringWidth("9999") + 16;
        Dimension fixed = new Dimension(lnw, 0);
        lineNumbers.setPreferredSize(fixed);
        lineNumbers.setMinimumSize(fixed);
        lineNumbers.setMaximumSize(new Dimension(lnw, Integer.MAX_VALUE));
        updateLineNumbers();

        JScrollPane scroll = new JScrollPane(textPane);
        scroll.setRowHeaderView(lineNumbers);
        scroll.setBorder(null);
        scroll.getViewport().setBackground(Theme.APP_BG);
        add(scroll, BorderLayout.CENTER);

        highlightTimer = new javax.swing.Timer(500, e -> SwingUtilities.invokeLater(() -> {
            updateLineNumbers();
            SyntaxHighlighter.applyHighlighting(textPane);
        }));
        highlightTimer.setRepeats(false);

        textPane.getDocument().addDocumentListener(new DocumentListener() {
            @Override public void insertUpdate(DocumentEvent e) { onChange(); }
            @Override public void removeUpdate(DocumentEvent e) { onChange(); }
            @Override public void changedUpdate(DocumentEvent e) {}
        });
    }

    private void onChange() {
        if (highlightTimer.isRunning()) highlightTimer.restart();
        else highlightTimer.start();
    }

    private void updateLineNumbers() {
        int lines = textPane.getDocument().getDefaultRootElement().getElementCount();
        if (lines == lastLineCount) return;
        lastLineCount = lines;
        StringBuilder sb = new StringBuilder();
        for (int i = 1; i <= lines; i++) sb.append(i).append("\n");
        lineNumbers.setText(sb.toString());
    }

    private void drawErrorUnderlines(Graphics g) {
        if (currentErrors.isEmpty()) return;
        Graphics2D g2 = (Graphics2D) g.create();
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
        int docLen = textPane.getDocument().getLength();
        for (CodeError err : currentErrors) {
            if (err.startOffset >= docLen) continue;
            try {
                int s = Math.min(err.startOffset, docLen - 1);
                int e = Math.min(err.endOffset > s ? err.endOffset : s + 1, docLen);
                Rectangle sr = textPane.modelToView2D(s).getBounds();
                Rectangle er = textPane.modelToView2D(e).getBounds();
                int x1 = sr.x, x2 = er.x > x1 ? er.x : x1 + 40;
                int y  = sr.y + sr.height;
                Color col = err.severity == CodeError.Severity.ERROR   ? Theme.DANGER_COLOR  :
                            err.severity == CodeError.Severity.WARNING  ? Theme.WARNING_COLOR :
                            err.severity == CodeError.Severity.INFO     ? Theme.TEXT_MUTED    : Theme.CYAN_COLOR;
                g2.setColor(col);
                g2.setStroke(new BasicStroke(1.5f));
                boolean up = true;
                for (int xp = x1; xp < Math.min(x2, textPane.getWidth() - 4); xp += 4) {
                    g2.drawLine(xp, y + (up ? -2 : 0), Math.min(xp + 4, x2), y + (up ? 0 : -2));
                    up = !up;
                }
            } catch (BadLocationException ignore) {}
        }
        g2.dispose();
    }

    public void setErrors(List<CodeError> errors) {
        this.currentErrors = errors != null ? errors : new ArrayList<>();
        textPane.repaint();
    }

    public void clearErrors() { setErrors(null); }
    public void undo()        { if (undoManager.canUndo()) undoManager.undo(); }
    public void redo()        { if (undoManager.canRedo()) undoManager.redo(); }

    public int getCurrentLine() {
        int pos = textPane.getCaretPosition();
        return textPane.getDocument().getDefaultRootElement().getElementIndex(pos) + 1;
    }

    public void goToLine(int line) {
        try {
            Element root = textPane.getDocument().getDefaultRootElement();
            if (line > 0 && line <= root.getElementCount()) {
                textPane.setCaretPosition(root.getElement(line - 1).getStartOffset());
                textPane.requestFocus();
            }
        } catch (Exception ignore) {}
    }

    public void toggleLineComment() {
        try {
            int     line = getCurrentLine();
            Element elem = textPane.getDocument().getDefaultRootElement().getElement(line - 1);
            int s = elem.getStartOffset(), e = elem.getEndOffset();
            String txt = textPane.getDocument().getText(s, e - s);
            if (txt.trim().startsWith("//")) textPane.getDocument().remove(s + txt.indexOf("//"), 2);
            else textPane.getDocument().insertString(s, "//", null);
        } catch (BadLocationException ignore) {}
    }
}

// ============================================================================
// FILE EXPLORER
// ============================================================================
class FileExplorer extends JPanel {
    private final JTree                     fileTree;
    private final DefaultMutableTreeNode    rootNode;
    private       DefaultTreeModel          treeModel;
    private final java.util.function.Consumer<File> openCb;
    private       File currentDir;

    public FileExplorer(java.util.function.Consumer<File> openCb) {
        this.openCb = openCb;
        setLayout(new BorderLayout());
        setBackground(Theme.SIDEBAR_COLOR);
        setPreferredSize(new Dimension(220, 0));

        JPanel hdr = new JPanel(new BorderLayout());
        hdr.setBackground(Theme.SURFACE_COLOR);
        hdr.setBorder(BorderFactory.createCompoundBorder(
            BorderFactory.createMatteBorder(0, 0, 1, 0, Theme.BORDER_COLOR),
            BorderFactory.createEmptyBorder(8, 12, 6, 8)));
        JLabel title = new JLabel("FILES");
        title.setFont(Theme.UI_FONT_BOLD);
        title.setForeground(Theme.TEXT_MUTED);
        JButton openBtn = new JButton("Open Folder");
        openBtn.setFont(Theme.UI_FONT_SMALL);
        openBtn.setForeground(Theme.PRIMARY_COLOR);
        openBtn.setBackground(Theme.SURFACE_COLOR);
        openBtn.setBorder(BorderFactory.createEmptyBorder(2, 6, 2, 6));
        openBtn.setFocusPainted(false);
        openBtn.setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
        openBtn.addActionListener(e -> chooseFolder());
        hdr.add(title, BorderLayout.WEST);
        hdr.add(openBtn, BorderLayout.EAST);

        rootNode  = new DefaultMutableTreeNode("Files");
        treeModel = new DefaultTreeModel(rootNode);
        fileTree  = new JTree(treeModel);
        fileTree.setRootVisible(false);
        fileTree.setShowsRootHandles(true);
        fileTree.setBackground(Theme.SIDEBAR_COLOR);
        fileTree.setForeground(Theme.TEXT_MAIN);
        fileTree.setFont(Theme.UI_FONT_SMALL);
        fileTree.setRowHeight(24);
        fileTree.setBorder(BorderFactory.createEmptyBorder(4, 4, 4, 4));
        fileTree.setUI(new BasicTreeUI() {
            @Override public Icon getExpandedIcon()  { return new VectorIcon(VectorIcon.Type.ARROW_DOWN,  12, Theme.TEXT_MUTED); }
            @Override public Icon getCollapsedIcon() { return new VectorIcon(VectorIcon.Type.ARROW_RIGHT, 12, Theme.TEXT_MUTED); }
        });
        fileTree.setCellRenderer(new DefaultTreeCellRenderer() {
            @Override
            public Component getTreeCellRendererComponent(JTree tr, Object v, boolean sel,
                    boolean exp, boolean leaf, int row, boolean focus) {
                super.getTreeCellRendererComponent(tr, v, sel, exp, leaf, row, focus);
                setBackground(sel ? Theme.CURRENT_LINE : Theme.SIDEBAR_COLOR);
                setOpaque(true);
                setBorder(BorderFactory.createEmptyBorder(1, 2, 1, 2));
                if (v instanceof DefaultMutableTreeNode) {
                    Object o = ((DefaultMutableTreeNode) v).getUserObject();
                    if (o instanceof File) {
                        File f = (File) o;
                        setText(f.getName());
                        boolean isDir = f.isDirectory();
                        setForeground(isDir ? Theme.CYAN_COLOR : f.getName().endsWith(".java") ? Theme.PRIMARY_COLOR : Theme.TEXT_MUTED);
                        setIcon(new VectorIcon(isDir ? VectorIcon.Type.FOLDER : VectorIcon.Type.FILE, 14,
                                isDir ? Theme.CYAN_COLOR : Theme.TEXT_MUTED));
                    }
                }
                return this;
            }
        });
        fileTree.addMouseListener(new MouseAdapter() {
            @Override public void mouseClicked(MouseEvent e) {
                if (e.getClickCount() == 2) {
                    DefaultMutableTreeNode node = (DefaultMutableTreeNode) fileTree.getLastSelectedPathComponent();
                    if (node != null && node.getUserObject() instanceof File) {
                        File f = (File) node.getUserObject();
                        if (f.isFile()) openCb.accept(f);
                    }
                }
            }
        });

        JScrollPane scroll = new JScrollPane(fileTree);
        scroll.setBorder(null);
        scroll.getViewport().setBackground(Theme.SIDEBAR_COLOR);
        add(hdr, BorderLayout.NORTH);
        add(scroll, BorderLayout.CENTER);
    }

    private void chooseFolder() {
        JFileChooser fc = new JFileChooser(currentDir);
        Theme.themeFileChooser(fc);
        fc.setFileSelectionMode(JFileChooser.DIRECTORIES_ONLY);
        fc.setDialogTitle("Open Folder");
        if (fc.showOpenDialog(this) == JFileChooser.APPROVE_OPTION)
            setDirectory(fc.getSelectedFile());
    }

    public void setDirectory(File dir) {
        this.currentDir = dir;
        rootNode.removeAllChildren();
        if (dir != null && dir.isDirectory()) populate(dir, rootNode);
        treeModel.reload();
        for (int i = 0; i < fileTree.getRowCount(); i++) fileTree.expandRow(i);
    }

    private void populate(File dir, DefaultMutableTreeNode parent) {
        File[] files = dir.listFiles();
        if (files == null) return;
        Arrays.sort(files, (a, b) -> {
            if (a.isDirectory() && !b.isDirectory()) return -1;
            if (!a.isDirectory() && b.isDirectory()) return 1;
            return a.getName().compareToIgnoreCase(b.getName());
        });
        for (File f : files) {
            if (!f.isHidden() && (f.isDirectory() || f.getName().endsWith(".java"))) {
                DefaultMutableTreeNode node = new DefaultMutableTreeNode(f);
                parent.add(node);
                if (f.isDirectory()) populate(f, node);
            }
        }
    }
}

