class TerminalPanel extends JPanel {
    private final JTextPane area;
    private final JLabel    titleLabel;
    private CodeEditor currentEditor;

    public TerminalPanel() {
        setLayout(new BorderLayout());
        JPanel hdr = new JPanel(new BorderLayout());
        hdr.setBackground(Theme.SURFACE_COLOR);
        hdr.setBorder(BorderFactory.createCompoundBorder(
            BorderFactory.createMatteBorder(1, 0, 0, 0, Theme.BORDER_COLOR),
            BorderFactory.createEmptyBorder(5, 12, 5, 12)));
        titleLabel = new JLabel("ISSUES");
        titleLabel.setFont(Theme.UI_FONT_BOLD);
        titleLabel.setForeground(Theme.TEXT_MUTED);
        JButton clearBtn = new JButton("Clear");
        clearBtn.setFont(Theme.UI_FONT_SMALL);
        clearBtn.setForeground(Theme.TEXT_MUTED);
        clearBtn.setBackground(Theme.SURFACE_COLOR);
        clearBtn.setBorder(BorderFactory.createEmptyBorder(2, 8, 2, 8));
        clearBtn.setFocusPainted(false);
        clearBtn.setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
        clearBtn.addActionListener(e -> clear());
        hdr.add(titleLabel, BorderLayout.WEST);
        hdr.add(clearBtn, BorderLayout.EAST);

        area = new JTextPane();
        area.setEditable(false);
        area.setFont(Theme.TERMINAL_FONT);
        area.setBackground(new Color(0x1a1b23));
        area.setForeground(Theme.TEXT_MAIN);
        area.setBorder(BorderFactory.createEmptyBorder(10, 14, 10, 14));
        area.addMouseListener(new MouseAdapter() {
            @Override public void mouseClicked(MouseEvent e) { handleClick(e); }
        });
        area.addMouseMotionListener(new MouseMotionAdapter() {
            @Override public void mouseMoved(MouseEvent e) {
                area.setCursor(isOverLink(e)
                    ? Cursor.getPredefinedCursor(Cursor.HAND_CURSOR)
                    : Cursor.getDefaultCursor());
            }
        });
        JScrollPane scroll = new JScrollPane(area);
        scroll.setBorder(null);
        scroll.setPreferredSize(new Dimension(0, 195));
        add(hdr, BorderLayout.NORTH);
        add(scroll, BorderLayout.CENTER);
    }

    public void setCurrentEditor(CodeEditor ed) { this.currentEditor = ed; }

    public void displayErrors(ErrorManager em) {
        area.setText("");
        StyledDocument doc = area.getStyledDocument();
        Style plain = mkStyle("plain", Theme.TEXT_MAIN,          false, false);
        Style muted = mkStyle("muted", Theme.TEXT_MUTED,         false, true);
        Style errS  = mkStyle("err",   Theme.DANGER_COLOR,       true,  false);
        Style warnS = mkStyle("warn",  Theme.WARNING_COLOR,      true,  false);
        Style infoS = mkStyle("info",  new Color(0x8be9fd),      false, false);
        Style hintS = mkStyle("hint",  Theme.TEXT_MUTED,         false, true);
        Style okS   = mkStyle("ok",    Theme.SUCCESS_COLOR,      true,  false);
        Style headS = mkStyle("head",  Theme.PRIMARY_COLOR,      true,  false);
        List<CodeError> all = em.getErrors();
        try {
            if (all.isEmpty()) {
                ins(doc, "  \u2713  No issues found \u2014 your code looks good!\n\n", okS);
                ins(doc, "  Tip: Press Ctrl+Enter any time to re-check after editing.\n", muted);
                updateTitle(0, 0, 0); return;
            }
            int ec = em.getErrorCount(), wc = em.getWarningCount(), ic = em.getInfoCount();
            ins(doc, "  Java Check Results  \u2014  ", headS);
            if (ec > 0) ins(doc, ec + " error"   + (ec > 1 ? "s" : "") + "  ", errS);
            if (wc > 0) ins(doc, wc + " warning" + (wc > 1 ? "s" : "") + "  ", warnS);
            if (ic > 0) ins(doc, ic + " hint"    + (ic > 1 ? "s" : ""),         infoS);
            ins(doc, "\n", plain);
            ins(doc, "  Click any line number to jump to it in the editor.\n", muted);
            ins(doc, "  \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n", muted);

            List<CodeError> errors   = filterBy(all, CodeError.Severity.ERROR);
            List<CodeError> warnings = filterBy(all, CodeError.Severity.WARNING);
            List<CodeError> infos    = filterBy(all, CodeError.Severity.INFO);
            List<CodeError> hints    = filterBy(all, CodeError.Severity.HINT);

            if (!errors.isEmpty())   { ins(doc, "  ERRORS\n",   errS);  for (CodeError e : errors)   printEntry(doc, "\u2717", e, errS,  hintS, plain); ins(doc, "\n", plain); }
            if (!warnings.isEmpty()) { ins(doc, "  WARNINGS\n", warnS); for (CodeError e : warnings) printEntry(doc, "\u26a0", e, warnS, hintS, plain); ins(doc, "\n", plain); }
            if (!infos.isEmpty())    { ins(doc, "  INFO\n",     infoS); for (CodeError e : infos)    printEntry(doc, "\u2139", e, infoS, hintS, plain); ins(doc, "\n", plain); }
            if (!hints.isEmpty())    { ins(doc, "  HINTS\n",    hintS); for (CodeError e : hints)    printEntry(doc, "\u2192", e, hintS, hintS, plain); }
            updateTitle(ec, wc, ic);
        } catch (BadLocationException ex) { area.setText("Display error: " + ex.getMessage()); }
    }

    private void printEntry(StyledDocument doc, String icon, CodeError e,
                            Style primary, Style hintSty, Style plain) throws BadLocationException {
        ins(doc, "  " + icon + "  ", primary);
        ins(doc, String.format("Line %4d", e.line), primary);
        ins(doc, ":  " + e.message + "\n", plain);
        if (e.hint != null && !e.hint.isEmpty())
            ins(doc, "          Fix: " + e.hint + "\n", hintSty);
    }

    private List<CodeError> filterBy(List<CodeError> all, CodeError.Severity sev) {
        List<CodeError> out = new ArrayList<>();
        for (CodeError e : all) if (e.severity == sev) out.add(e);
        return out;
    }

    private void ins(StyledDocument doc, String text, Style style) throws BadLocationException {
        doc.insertString(doc.getLength(), text, style);
    }

    private Style mkStyle(String name, Color fg, boolean bold, boolean italic) {
        Style s = area.addStyle(name, null);
        StyleConstants.setForeground(s, fg);
        StyleConstants.setFontFamily(s, "Consolas");
        StyleConstants.setFontSize(s, 13);
        StyleConstants.setBold(s, bold);
        StyleConstants.setItalic(s, italic);
        return s;
    }

    private void updateTitle(int e, int w, int i) {
        titleLabel.setText(e == 0 && w == 0 && i == 0 ? "ISSUES"
            : "ISSUES \u2014 " + e + " error" + (e != 1 ? "s" : "") + ", " + w + " warning" + (w != 1 ? "s" : ""));
    }

    private void handleClick(MouseEvent e) {
        if (currentEditor == null) return;
        int off = area.viewToModel2D(e.getPoint());
        try {
            Element root = area.getDocument().getDefaultRootElement();
            Element el = root.getElement(root.getElementIndex(off));
            String txt = area.getDocument().getText(el.getStartOffset(), el.getEndOffset() - el.getStartOffset());
            Matcher m = Pattern.compile("Line\\s+(\\d+)").matcher(txt);
            if (m.find()) currentEditor.goToLine(Integer.parseInt(m.group(1)));
        } catch (BadLocationException ignore) {}
    }

    private boolean isOverLink(MouseEvent e) {
        int off = area.viewToModel2D(e.getPoint());
        try {
            Element root = area.getDocument().getDefaultRootElement();
            Element el   = root.getElement(root.getElementIndex(off));
            String txt   = area.getDocument().getText(el.getStartOffset(), el.getEndOffset() - el.getStartOffset());
            return Pattern.compile("Line\\s+\\d+").matcher(txt).find();
        } catch (BadLocationException ignore) { return false; }
    }

    public void clear() { area.setText(""); titleLabel.setText("ISSUES"); }
}

